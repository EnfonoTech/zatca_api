          "mode": "raw",
          "raw": "{\n  \"external_id\": \"{{external_id}}\",\n  \"customer\": \"{{customer}}\",\n  \"company\": \"{{company}}\",\n  \"tax_id\": \"{{buyer_vat}}\",\n  \"buyer_id_type\": \"CRN\",\n  \"buyer_id_value\": \"1010101010\",\n  \"posting_date\": \"{{posting_date}}\",\n  \"posting_time\": \"11:30:00\",\n  \"due_date\": \"{{due_date}}\",\n  \"currency\": \"SAR\",\n  \"po_no\": \"PO-4471\",\n  \"remarks\": \"Created via zatca_api\",\n  \"address_title\": \"{{customer}} Billing\",\n  \"address_parts\": {\n    \"street\": \"Olaya Street\",\n    \"additional_street\": \"Al Murabba\",\n    \"building_number\": \"4521\",\n    \"district\": \"Al Murabba\",\n    \"city\": \"Riyadh\",\n    \"postal_code\": \"12613\",\n    \"country\": \"Saudi Arabia\"\n  },\n  \"items\": [\n    {\n      \"item_code\": \"{{item_code}}\",\n      \"item_name\": \"Consulting services\",\n      \"description\": \"Implementation retainer, August 2026\",\n      \"qty\": 10,\n      \"rate\": 450,\n      \"uom\": \"Nos\",\n      \"item_tax_template\": \"{{item_tax_template}}\"\n    },\n    {\n      \"item_code\": \"{{item_code}}\",\n      \"item_name\": \"Onsite support day\",\n      \"qty\": 2,\n      \"rate\": 1200,\n      \"discount_percentage\": 10\n    }\n  ],\n  \"taxes\": [\n    {\n      \"account_head\": \"{{vat_account}}\",\n      \"charge_type\": \"On Net Total\",\n      \"rate\": 15,\n      \"description\": \"VAT 15%\"\n    }\n  ],\n  \"submit\": true\n}",
