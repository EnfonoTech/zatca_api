    {
      "name": "06 Create credit note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{api_key}}:{{api_secret}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/method/zatca_api.api.v1.create_credit_note"
        },
        "description": "Creates a return (is_return = 1) against {{last_invoice}}, set by an earlier request.\n\nItem quantities are sign-normalised, so send positive or negative figures - either works. `return_against` is optional but when given must reference a SUBMITTED invoice, which is also what ZATCA expects of a credit note.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"external_id\": \"CN-{{external_id}}\",\n  \"customer\": \"{{customer}}\",\n  \"company\": \"{{company}}\",\n  \"posting_date\": \"{{posting_date}}\",\n  \"return_against\": \"{{last_invoice}}\",\n  \"items\": [\n    {\n      \"item_code\": \"{{item_code}}\",\n      \"qty\": 1,\n      \"rate\": 100\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Every endpoint returns the same envelope, inside frappe's \"message\" wrapper.",
              "const body = pm.response.json();",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"envelope present\", () => pm.expect(body).to.have.property(\"message\"));",
