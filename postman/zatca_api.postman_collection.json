        "type": "string"
      },
      {
        "key": "value",
        "value": "token {{api_key}}:{{api_secret}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Default posting_date/due_date to today and today+30 when unset.",
          "const pad = n => String(n).padStart(2, \"0\");",
          "const fmt = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
          "if (!pm.collectionVariables.get(\"posting_date\")) {",
          "    pm.collectionVariables.set(\"posting_date\", fmt(new Date()));",
          "}",
          "if (!pm.collectionVariables.get(\"due_date\")) {",
          "    const d = new Date(); d.setDate(d.getDate() + 30);",
          "    pm.collectionVariables.set(\"due_date\", fmt(d));",
          "}",
          "if (!pm.collectionVariables.get(\"external_id\")) {",
          "    pm.collectionVariables.set(\"external_id\", \"PM-\" + Date.now());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "external_id",
      "value": "",
      "description": "Auto-generated per run."
    },
    {
      "key": "draft_external_id",
      "value": ""
    },
    {
      "key": "last_invoice",
      "value": "",
      "description": "Captured from the last create."
    },
    {
      "key": "last_qr_png",
      "value": "",
      "description": "Base64 PNG from the last create."
    },
    {
      "key": "posting_date",
      "value": ""
    },
    {
      "key": "due_date",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Ping (start here)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{api_key}}:{{api_secret}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/method/zatca_api.api.v1.ping"
        },
        "description": "Health and capability probe. Confirms authentication works, the custom fields are migrated, whether ksa_compliance is installed, and which ZATCA phase each company resolves to. Run this first whenever an integration misbehaves."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Every endpoint returns the same envelope, inside frappe's \"message\" wrapper.",
              "const body = pm.response.json();",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"envelope present\", () => pm.expect(body).to.have.property(\"message\"));",
              "const env = body.message;",
              "pm.test(\"success = true\", () => pm.expect(env.success, JSON.stringify(env.errors)).to.be.true);",
              "pm.test(\"no errors\", () => pm.expect(env.errors).to.be.an(\"array\").that.is.empty);",
              "pm.test(\"request_id echoed\", () => pm.expect(env.request_id).to.be.a(\"string\"));",
              "",
              "const d = env.data;",
              "pm.test(\"app enabled\", () => pm.expect(d.enabled).to.be.true);",
              "pm.test(\"custom fields migrated\", () => pm.expect(d.custom_fields_installed).to.be.true);",
              "console.log(\"version:\", d.version, \"| submit_mode:\", d.submit_mode);",
              "console.log(\"ksa_compliance installed:\", d.readiness.ksa_compliance_installed,",
              "            \"version:\", d.readiness.ksa_compliance_version);",
              "(d.readiness.companies || []).forEach(c => console.log(\"  \", c.company, \"->\", c.phase));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create invoice (minimal)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{api_key}}:{{api_secret}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/method/zatca_api.api.v1.create_invoice"
        },
        "description": "The smallest payload that works. Submits the invoice (per ZATCA API Settings) and returns the QR in the same response.\n\nA ZATCA QR only exists for a SUBMITTED invoice. If `zatca.available` is false, read `zatca.reason`.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"external_id\": \"{{external_id}}\",\n  \"customer\": \"{{customer}}\",\n  \"company\": \"{{company}}\",\n  \"posting_date\": \"{{posting_date}}\",\n  \"items\": [\n    {\n      \"item_code\": \"{{item_code}}\",\n      \"qty\": 2,\n      \"rate\": 100\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Give every run a fresh external_id so the request creates rather than dedupes.",
              "// Re-send the SAME id to see idempotency: you get action=\"duplicate\" back.",
              "pm.collectionVariables.set(\"external_id\", \"PM-\" + Date.now());",
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Every endpoint returns the same envelope, inside frappe's \"message\" wrapper.",
              "const body = pm.response.json();",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"envelope present\", () => pm.expect(body).to.have.property(\"message\"));",
              "const env = body.message;",
              "pm.test(\"success = true\", () => pm.expect(env.success, JSON.stringify(env.errors)).to.be.true);",
              "pm.test(\"no errors\", () => pm.expect(env.errors).to.be.an(\"array\").that.is.empty);",
              "pm.test(\"request_id echoed\", () => pm.expect(env.request_id).to.be.a(\"string\"));",
              "",
              "const data = env.data;",
              "pm.test(\"invoice returned\", () => pm.expect(data.invoice.invoice).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"last_invoice\", data.invoice.invoice);",
              "",
              "// The ZATCA block is ALWAYS present. `available` tells you whether a QR exists.",
              "pm.test(\"zatca block present\", () => pm.expect(data).to.have.property(\"zatca\"));",
              "if (data.zatca.available) {",
              "    pm.test(\"QR image returned\", () => pm.expect(data.zatca.qr_png_base64).to.be.a(\"string\").and.not.empty);",
              "    console.log(\"ZATCA phase:\", data.zatca.phase);",
              "    console.log(\"integration_status:\", data.zatca.integration_status);",
              "    if (data.zatca.uuid) console.log(\"uuid:\", data.zatca.uuid);",
              "    if (data.zatca.invoice_hash) console.log(\"invoice_hash:\", data.zatca.invoice_hash);",
              "    pm.collectionVariables.set(\"last_qr_png\", data.zatca.qr_png_base64);",
              "} else {",
              "    console.warn(\"No ZATCA QR:\", data.zatca.reason);",
              "}",
              "if (env.warnings.length) console.warn(\"Warnings:\", env.warnings.join(\" | \"));",
              ""
            ]
          }
        }
      ]
    },
