        "description": "A buyer VAT number makes this a ZATCA **standard** invoice, and a standard invoice requires a complete buyer address. Expect `valid: false` with a per-field list.\n\nThis mirrors `ksa_compliance`, which validates the buyer address whenever the invoice type is Standard and throws outright when a B2B customer has no address.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"external_id\": \"{{external_id}}\",\n  \"customer\": \"B2B No Address Co\",\n  \"company\": \"{{company}}\",\n  \"tax_id\": \"{{buyer_vat}}\",\n  \"posting_date\": \"{{posting_date}}\",\n  \"items\": [\n    {\n      \"item_code\": \"{{item_code}}\",\n      \"qty\": 1,\n      \"rate\": 100\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"external_id\", \"PM-\" + Date.now());",
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const env = pm.response.json().message;",
              "const d = env.data;",
              "pm.test(\"HTTP 200 \u2014 the check ran\", () => pm.response.to.have.status(200));",
              "pm.test(\"rejected, as it should be\", () => pm.expect(d.valid).to.be.false);",
              "pm.test(\"names the address as the problem\", () =>",
              "    pm.expect(JSON.stringify(d.errors)).to.include(\"address\"));",
              "console.warn(\"errors:\", JSON.stringify(d.errors, null, 2));",
              ""
            ]
          }
        }
      ]
