          "raw": "{{base_url}}/api/method/zatca_api.api.v1.create_invoice"
        },
        "description": "One standard-rated line and one zero-rated line, using the Item Tax Templates the seeder created.\n\nExpect VAT on the standard line only: net 2000, VAT **150** (not 300), grand 2150. If VAT comes back as 300, per-line tax templates are being ignored and zero-rated lines are being charged.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"external_id\": \"{{external_id}}\",\n  \"customer\": \"{{customer_b2b}}\",\n  \"company\": \"{{company}}\",\n  \"tax_id\": \"{{buyer_vat}}\",\n  \"posting_date\": \"{{posting_date}}\",\n  \"address_title\": \"{{customer_b2b}} Billing\",\n  \"address_parts\": {\n    \"street\": \"Olaya Street\",\n    \"building_number\": \"4521\",\n    \"district\": \"Al Murabba\",\n    \"city\": \"Riyadh\",\n    \"postal_code\": \"12613\",\n    \"country\": \"Saudi Arabia\"\n  },\n  \"items\": [\n    {\n      \"item_code\": \"{{item_code}}\",\n      \"qty\": 1,\n      \"rate\": 1000,\n      \"item_tax_template\": \"{{item_tax_standard}}\"\n    },\n    {\n      \"item_code\": \"{{item_code_zero}}\",\n      \"qty\": 1,\n      \"rate\": 1000,\n      \"item_tax_template\": \"{{item_tax_zero}}\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"external_id\", \"PM-\" + Date.now());",
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"envelope present\", () => pm.expect(body).to.have.property(\"message\"));",
              "const env = body.message;",
              "pm.test(\"success = true\", () => pm.expect(env.success, JSON.stringify(env.errors)).to.be.true);",
              "",
              "const d = env.data;",
              "pm.collectionVariables.set(\"last_invoice\", d.invoice.invoice);",
              "console.log(\"invoice:\", d.invoice.invoice, \"| grand_total:\", d.invoice.grand_total, d.invoice.currency);",
              "const z = d.zatca;",
              "console.log(\"zatca:\", z.available, z.phase, z.integration_status);",
              "if (z.available && z.qr_png_base64) {",
              "    pm.collectionVariables.set(\"last_qr_png\", z.qr_png_base64);",
              "    pm.test(\"real QR returned\", () => pm.expect(z.qr_png_base64.length).to.be.above(200));",
              "    // The QR is a base64 PNG. Paste it into a data: URI to eyeball it, or decode it.",
              "    console.log(\"QR base64 length:\", z.qr_png_base64.length);",
              "} else {",
              "    console.warn(\"no QR:\", z.reason);",
              "}",
              "if (env.warnings.length) console.warn(\"warnings:\", env.warnings.join(\" | \"));",
              "",
              "const t = env.data.invoice;",
              "pm.test(\"net 2000\", () => pm.expect(t.net_total).to.eql(2000));",
              "pm.test(\"VAT on the standard line only (150, not 300)\", () =>",
              "    pm.expect(t.total_taxes_and_charges).to.eql(150));",
              ""
            ]
          }
        }
      ]
