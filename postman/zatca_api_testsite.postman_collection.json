    {
      "name": "07 Create invoice \u2014 mixed VAT rates",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{api_key}}:{{api_secret}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Frappe-Site-Name",
            "value": "{{site_name}}",
            "description": "Only needed when base_url is an IP or a tunnel; ignored otherwise."
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/method/zatca_api.api.v1.create_invoice",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "method",
            "zatca_api.api.v1.create_invoice"
          ]
        },
        "description": "One standard-rated line and one zero-rated line, using the Item Tax Templates the seeder created.\n\nExpect VAT on the standard line only: net 2000, VAT **150** (not 300), grand 2150. If VAT comes back as 300, per-line tax templates are being ignored and zero-rated lines are being charged.",
        "body": {
          "mode": "raw",
