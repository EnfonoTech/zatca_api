              "const env = body.message;",
              "pm.test(\"success = true\", () => pm.expect(env.success, JSON.stringify(env.errors)).to.be.true);",
              "",
              "const inv = env.data.invoice;",
              "pm.test(\"is a return\", () => pm.expect(inv.is_return).to.eql(1));",
              "pm.test(\"quantity negative\", () => pm.expect(inv.items[0].qty).to.be.below(0));",
              "console.log(\"credit note:\", inv.invoice, \"| net_total:\", inv.net_total);",
